# =============================================================================
# Variables de entorno de Buenaventura Reporta (Docker Compose)
#
#   1. Copia este archivo:      cp .env.example .env
#   2. Genera los secretos:     ./scripts/generar-secretos.sh   (o .ps1 en Windows)
#   3. Ajusta APP_URL/APP_PORT y el correo
#
# El archivo .env NUNCA se sube al repositorio.
# =============================================================================

# --- Acceso público -----------------------------------------------------------
# Puerto del host donde se publica la app (en el servidor de producción: 80)
APP_PORT=8080
# URL exacta que usa el navegador: se usa en los correos y en las URLs de imágenes
APP_URL=http://localhost:8080

# --- Secretos de Laravel ------------------------------------------------------
APP_KEY=
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# --- PostgreSQL ---------------------------------------------------------------
DB_DATABASE=buenaventura_reporta
DB_USERNAME=buenaventura
DB_PASSWORD=

# --- Redis --------------------------------------------------------------------
REDIS_PASSWORD=

# --- Laravel Reverb (WebSockets) ----------------------------------------------
REVERB_APP_ID=buenaventura
REVERB_APP_KEY=
REVERB_APP_SECRET=

# --- Logs ---------------------------------------------------------------------
# debug en local (muestra los correos de MAIL_MAILER=log); info o warning en producción
LOG_LEVEL=debug

# --- Correo -------------------------------------------------------------------
# "log" escribe los correos en los logs del backend (requiere LOG_LEVEL=debug).
# Para enviarlos de verdad: MAIL_MAILER=smtp y una contraseña de aplicación de Gmail.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@buenaventura-reporta.local

# --- Administrador inicial (solo se crea si la base está vacía) ---------------
ADMIN_EMAIL=admin@buenaventura.local
ADMIN_PASSWORD=

# --- Imágenes (las etiquetas las define el pipeline de CI/CD) -----------------
API_TAG=latest
FRONTEND_TAG=latest
